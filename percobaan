<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contoh Tabel Data</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
            padding: 20px;
        }

        .table-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        thead {
            background-color: #007bff;
            color: #ffffff;
        }

        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #e0e0e0;
        }

        /* Efek baris selang-seling (zebra stripe) */
        tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        /* Efek hover saat kursor diarahkan ke baris */
        tbody tr:hover {
            background-color: #f1f5f9;
        }

        /* Styling status */
        .status {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.85em;
            font-weight: bold;
        }

        .status-aktif {
            background-color: #d4edda;
            color: #155724;
        }

        .status-nonaktif {
            background-color: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>No</th>
                    <th>Nama</th>
                    <th>Email</th>
                    <th>Jabatan</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Budi Santoso</td>
                    <td>budi@example.com</td>
                    <td>Developer</td>
                    <td><span class="status status-aktif">Aktif</span></td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Siti Rahma</td>
                    <td>siti@example.com</td>
                    <td>Designer</td>
                    <td><span class="status status-aktif">Aktif</span></td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Ahmad Fauzi</td>
                    <td>ahmad@example.com</td>
                    <td>Manager</td>
                    <td><span class="status status-nonaktif">Nonaktif</span></td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Dewi Lestari</td>
                    <td>dewi@example.com</td>
                    <td>Marketing</td>
                    <td><span class="status status-aktif">Aktif</span></td>
                </tr>
            </tbody>
        </table>
    </div>

</body>
</html>