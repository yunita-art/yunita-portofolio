<!DOCTYPE html> 
<html lang="id"> 
<head> 
  <meta charset="UTF-8"> 
  <title>Belajar Dasar HTML dan CSS</title> 
  <style> 
    /* CSS Property & Warna Background */ 
    body { 
      background-color: #f4f4f9; 
      margin: 0; 
      /* Font Family */ 
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
    } 
 
    /* Flexbox untuk Layout Header */ 
    header { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 15px 30px; 
      background-color: #ffffff; 
      box-shadow: 0 2px 5px rgba(0,0,0,0.1); 
    } 
 
    .logo { 
      font-size: 20px; 
      font-weight: bold; 
      color: #333; 
    } 
 
    /* Text Tengah */ 
    .judul-utama { 
      text-align: center; 
      margin-top: 40px; 
      color: #2c3e50; 
    } 
 
    /* Garis Memanjang */ 
    hr { 
      border: none; 
      height: 2px; 
      background-color: #3498db; 
      width: 80%; 
      margin: 20px auto; 
    } 
 
    /* Menampilkan Gambar */ 
    .container-gambar { 
      text-align: center; 
      margin-top: 20px; 
    } 
 
    .gambar-banner { 
      width: 300px; 
      border-radius: 8px; 
    } 
 
    /* Logo Copyright di Footer */ 
    footer { 
      text-align: center; 
      padding: 20px; 
      margin-top: 50px; 
      background-color: #2c3e50; 
      color: #ffffff; 
    } 
  </style> 
</head> 
<body> 
 
  <!-- Header dengan Flexbox & Logo Copyright --> 
  <header> 
    <div class="logo">WebSaya &copy;</div> 
    <nav> 
      <span>Beranda</span> 
    </nav> 
  </header> 
<!-- Text Tengah --> 
<h1 class="judul-utama">Selamat Datang di Pembelajaran HTML & CSS</h1> 
<!-- Garis Memanjang --> 
<hr> 
<!-- Menampilkan Gambar --> 
<div class="container-gambar"> 
<img src="https://via.placeholder.com/300x150" alt="Contoh Gambar" 
class="gambar-banner"> 
</div> 
<!-- Footer dengan Logo Copyright (© / &copy;) --> 
<footer> 
<p>&copy; 2026 Hak Cipta Dilindungi Undang-Undang.</p> 
</footer> 
</body>
</html>